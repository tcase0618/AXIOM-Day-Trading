//@version=5
strategy("SLOT 7: Futures Horizontal", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5)

// VWAP for mean reversion
vwap = ta.vwap(hlc3)

// RSI for divergence detection
rsi = ta.rsi(close, 14)

// Calculate VWAP deviation
vwap_dev_pct = ((close - vwap) / vwap) * 100
price_above_vwap = vwap_dev_pct > 0.5
price_below_vwap = vwap_dev_pct < -0.5

// RSI divergence: RSI shows strength but price is overextended from VWAP
rsi_high = rsi > 60
rsi_low = rsi < 40

// Entry signal for LONG: price below VWAP by 0.5%+, RSI low (divergence signal)
entry_long = price_below_vwap and rsi_low and volume >= ta.sma(volume, 20) * 1.2

// Entry signal for SHORT: price above VWAP by 0.5%+, RSI high (divergence signal)
entry_short = price_above_vwap and rsi_high and volume >= ta.sma(volume, 20) * 1.2

// Stops: 0.75% from entry
stop_offset_pct = 0.0075

// Position tracking
var stop_long = 0.0
var stop_short = 0.0
var target = 0.0

if entry_long and strategy.position_size == 0
    stop_long := close * (1.0 - stop_offset_pct)
    target := vwap
    strategy.entry("Long", strategy.long)

if entry_short and strategy.position_size == 0
    stop_short := close * (1.0 + stop_offset_pct)
    target := vwap
    strategy.entry("Short", strategy.short)

// Exit conditions
if strategy.position_size > 0
    strategy.exit("Exit Long", from_entry="Long", stop=stop_long, limit=target)

if strategy.position_size < 0
    strategy.exit("Exit Short", from_entry="Short", stop=stop_short, limit=target)

// Plotting
plot(vwap, "VWAP", color.green, 2)
plot(rsi, "RSI", color.purple, 1)
hline(40, "RSI 40", color.gray, linestyle=hline.style_dashed)
hline(60, "RSI 60", color.gray, linestyle=hline.style_dashed)
hline(50, "RSI 50", color.gray, linestyle=hline.style_dashed)

alertcondition(entry_long, title="Slot 7 Long Entry", message="SLOT 7 Long Mean Reversion: {{ticker}}")
alertcondition(entry_short, title="Slot 7 Short Entry", message="SLOT 7 Short Mean Reversion: {{ticker}}")
