//@version=5
strategy("EQUITIES VWAP Mean Reversion - AAPL 5min", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1)

// ===== SETTINGS =====
RSI_OVERSOLD = 30
RSI_OVERBOUGHT = 70
MIN_VOLUME_MULT = 1.5
ATR_PERIOD = 14
RSI_PERIOD = 14
STDDEV_MULT = 2.0

// ===== SESSION FILTER (Eastern Time: 10:30am - 2:30pm) =====
is_trading_hours = (hour == 10 and minute >= 30) or (hour >= 11 and hour <= 13) or (hour == 14 and minute <= 30)

// ===== INDICATORS =====
atr = ta.atr(ATR_PERIOD)
rsi = ta.rsi(close, RSI_PERIOD)
vol_avg = ta.sma(volume, 20)
vwap_val = ta.vwap(close)
bb_basis = ta.sma(close, 20)
bb_dev = ta.stdev(close, 20)
bb_upper = bb_basis + (bb_dev * STDDEV_MULT)
bb_lower = bb_basis - (bb_dev * STDDEV_MULT)

// ===== ENTRY CONDITIONS =====
// Long Mean Reversion: Below VWAP + RSI oversold, recover above VWAP
long_setup = close < vwap_val and rsi < RSI_OVERSOLD and volume > (vol_avg * MIN_VOLUME_MULT)
entry_long = is_trading_hours and long_setup and close > vwap_val and strategy.position_size == 0

// Short Mean Reversion: Above VWAP + RSI overbought, recover below VWAP
short_setup = close > vwap_val and rsi > RSI_OVERBOUGHT and volume > (vol_avg * MIN_VOLUME_MULT)
entry_short = is_trading_hours and short_setup and close < vwap_val and strategy.position_size == 0

// ===== SWING HIGHS AND LOWS =====
var array<float> swing_highs = array.new<float>()
var array<float> swing_lows = array.new<float>()

swing_high = high[3] < high[2] and high[2] > high[1] and high[2] > high[0]
swing_low = low[3] > low[2] and low[2] < low[1] and low[2] < low[0]

if swing_high
    array.push(swing_highs, high[1])
    if array.size(swing_highs) > 20
        array.shift(swing_highs)

if swing_low
    array.push(swing_lows, low[1])
    if array.size(swing_lows) > 20
        array.shift(swing_lows)

// ===== POSITION TRACKING =====
var float entry_price = 0.0
var float stop_level = 0.0
var float target_level = 0.0
var int bars_in_trade = 0
var int trades_today = 0

if hour == 10 and minute == 30
    trades_today := 0

// ===== LONG ENTRY =====
if entry_long and trades_today < 2
    entry_price := close
    stop_level := entry_price - (atr * 2.0)  // Wider stop for equities
    target_level := vwap_val

    for i = 0 to array.size(swing_highs) - 1
        sh = array.get(swing_highs, i)
        if sh > entry_price and sh - entry_price <= (entry_price * 0.03) and sh > target_level
            target_level := sh

    bars_in_trade := 0
    trades_today += 1
    strategy.entry("Long", strategy.long, qty=1)

// ===== SHORT ENTRY =====
if entry_short and trades_today < 2
    entry_price := close
    stop_level := entry_price + (atr * 2.0)
    target_level := vwap_val

    for i = 0 to array.size(swing_lows) - 1
        sl = array.get(swing_lows, i)
        if sl < entry_price and entry_price - sl <= (entry_price * 0.03) and sl < target_level
            target_level := sl

    bars_in_trade := 0
    trades_today += 1
    strategy.entry("Short", strategy.short, qty=1)

// ===== TRACK BARS IN TRADE =====
if strategy.position_size != 0
    bars_in_trade += 1

// ===== TIME EXIT: 60 minutes =====
if strategy.position_size != 0 and bars_in_trade > 12
    strategy.close_all(comment="Mean reversion time exit")

// ===== EXIT =====
if strategy.position_size > 0
    strategy.exit("Exit_Long", stop=stop_level, limit=target_level)

if strategy.position_size < 0
    strategy.exit("Exit_Short", stop=stop_level, limit=target_level)

// ===== PLOTTING =====
plot(vwap_val, "VWAP", color.blue, 2)
plot(bb_upper, "BB Upper", color.new(color.gray, 60))
plot(bb_lower, "BB Lower", color.new(color.gray, 60))

plotchar(entry_long, "Long Entry (MR)", "▲", location.belowbar, color.green, size=size.small)
plotchar(entry_short, "Short Entry (MR)", "▼", location.abovebar, color.red, size=size.small)

stop_plot = strategy.position_size > 0 ? stop_level : na
target_plot = strategy.position_size > 0 ? target_level : na
plot(stop_plot, "Stop", color.red, 2)
plot(target_plot, "Target", color.green, 2)
